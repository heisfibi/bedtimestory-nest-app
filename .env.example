PORT=8000

# MySQL / MariaDB. The database must exist; tables are created on startup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=storytime

# Signs studio sign-in sessions. Use a long random value; changing it signs
# everyone out. Sessions last SESSION_TTL (default 7d).
JWT_SECRET=
# SESSION_TTL=7d

# Optional. Where .akuko files and cover images are stored; served at /media.
# MEDIA_ROOT=

# Optional. Fixes the origin used in file, thumbnail and pagination URLs, e.g.
# https://api.example.com. Unset means "whatever Host the client used".
# PUBLIC_URL=

# Optional. LibreTranslate server used to translate book titles on save,
# e.g. https://libretranslate.com (needs an API key) or a self-hosted one.
# Without it, titles are shown untranslated.
# LIBRETRANSLATE_URL=
# LIBRETRANSLATE_API_KEY=

# Optional. A code that opens every book in the app, for Google Play's
# reviewers (given to them in Play Console > App content > Sign in details).
# Unset means no code works.
# REVIEWER_CODE=

# Optional. Push notifications go through Expo's push service; this is only
# needed once "Enhanced security for push notifications" is turned on at
# expo.dev (Project > Credentials > Access tokens).
# EXPO_ACCESS_TOKEN=

# Google Play Integrity: when true, the app's endpoints (book lists, analytics,
# notifications, backgrounds, music, reviewer code) only answer our own app,
# installed from Google Play. Development builds installed over USB are not
# recognised, so keep it false locally. The website's endpoints stay open.
APP_INTEGRITY_REQUIRED=false
# Needed when it's true: a Google Cloud service account's JSON key (the whole
# JSON, or a path to the file), from the Cloud project linked in Play Console >
# App integrity. The account needs no roles of its own.
# PLAY_INTEGRITY_SERVICE_ACCOUNT=
# That Cloud project's number (Cloud console > project dashboard): the app gets
# it from the backend, so nothing about it is built into the app.
# PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
# ANDROID_PACKAGE=com.fibigames.bedtimestories
